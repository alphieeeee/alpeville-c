# Strapi API
CV_DATA_SOURCE=strapi
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=replace-me

# Cache public Strapi content for 15 minutes by default.
STRAPI_REVALIDATE_SECONDS=900

# Canonical portfolio URL used by metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public-facing Strapi URL for browser-side calls or metadata helpers.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: use this if you later expose specific endpoints behind a base path.
STRAPI_API_PREFIX=/api
